# Export these in your shell. SWARM does not automatically load .env files.
# Required when coordinator binds to a LAN address. Use the same value on endpoints.
# SWARM_TOKEN=replace-with-a-random-value-at-least-16-characters

# Optional local model. No model call occurs unless BOTH values are configured.
# SWARM_LLM_BASE_URL=http://127.0.0.1:8080/v1
# SWARM_LLM_MODEL=tmax-local
